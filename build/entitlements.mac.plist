<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Kod imzalama + notarization için gerekli -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!--
    Endpoint Security ve Network Extension yetkileri burada YOK: bunlar
    provisioning profile gerektiren kısıtlı yetkilerdir ve profilsiz imzalanan
    bir uygulama macOS tarafından açılışta öldürülür. Bu yetkiler yalnızca
    native-daemon/ altındaki sistem genişletmelerine aittir.
  -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
